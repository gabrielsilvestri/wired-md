{
  "name": "wired-md",
  "version": "0.1.0",
  "description": "Desktop markdown editor in the spirit of Typora, for people who write markdown for AI",
  "main": "src/main/index.js",
  "bin": {
    "wired": "bin/wired.js"
  },
  "scripts": {
    "postinstall": "node scripts/sync-vendor.mjs",
    "prestart": "node scripts/sync-vendor.mjs",
    "start": "electron .",
    "test": "node --test tests/test-runner.js && node scripts/test-packaged-cli.js && node scripts/test.js",
    "test:cli": "node --test tests/test-runner.js && node scripts/test-packaged-cli.js",
    "smoke": "node scripts/test.js --smoke",
    "dist": "node scripts/sync-vendor.mjs && electron-builder --win",
    "smoke:installed": "node scripts/smoke-installed.mjs"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "typora",
    "ai",
    "claude",
    "wysiwyg"
  ],
  "author": "Gabriel Silvestri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielsilvestri/wired-md.git"
  },
  "homepage": "https://github.com/gabrielsilvestri/wired-md#readme",
  "bugs": {
    "url": "https://github.com/gabrielsilvestri/wired-md/issues"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "geist": "^1.7.2",
    "node-pty": "^1.1.0",
    "vditor": "^3.11.1",
    "yaml": "^2.9.0"
  }
}
